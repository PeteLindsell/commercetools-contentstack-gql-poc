BFF_SHARED_SECRET=dev-shared-secret
BFF_PORT=4000
BFF_URL=http://localhost:4000/graphql
BFF_GRAPHIQL=false

# commercetools. One locale, currency, store, and distribution channel.
# The API client needs manage_project so the seed can create the catalogue.
# Auth and API hosts depend on the project region, for example europe-west1.gcp.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_LOCALE=en-GB
CTP_CURRENCY=GBP
CTP_STORE_KEY=poc
CTP_CHANNEL_KEY=poc-retail
# Optional. Defaults to manage_project:$CTP_PROJECT_KEY
# CTP_SCOPES=manage_project:your-project-key
