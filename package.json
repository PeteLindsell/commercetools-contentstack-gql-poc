{
  "name": "commercetools-contentstack-gql-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Headless storefront PoC — Next.js storefront + private GraphQL BFF",
  "homepage": "https://github.com/PeteLindsell/commercetools-contentstack-gql-poc#readme",
  "bugs": {
    "url": "https://github.com/PeteLindsell/commercetools-contentstack-gql-poc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeteLindsell/commercetools-contentstack-gql-poc.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @poc/bff --filter @poc/storefront dev",
    "dev:bff": "pnpm --filter @poc/bff dev",
    "dev:storefront": "pnpm --filter @poc/storefront dev",
    "build": "pnpm -r --filter @poc/bff --filter @poc/storefront build",
    "test": "pnpm -r --filter @poc/bff --filter @poc/storefront test",
    "lint": "pnpm -r --filter @poc/bff --filter @poc/storefront lint",
    "typecheck": "pnpm -r --filter @poc/bff --filter @poc/storefront typecheck"
  }
}
